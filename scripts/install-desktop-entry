#!/usr/bin/env bash
# Install or remove the optional menu entry for this distribution tree.
set -euo pipefail

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
entry="$data_home/applications/proxenos.desktop"
icon="$data_home/icons/hicolor/scalable/apps/proxenos.svg"

if [[ "${1:-}" == --remove && $# == 1 ]]; then
  rm -f -- "$entry" "$icon"
  printf 'Removed the Proxenos desktop entry and icon.\n'
  exit 0
fi
if (( $# != 0 )); then
  printf 'usage: install-desktop-entry [--remove]\n' >&2
  exit 64
fi

script=$(readlink -f -- "$0")
tree=$(dirname -- "$(dirname -- "$script")")
gui="$tree/bin/gui"
[[ -x "$gui" && -f "$tree/share/icons/proxenos.svg" ]] || {
  printf 'install-desktop-entry: run the copy inside a linux-x64 Proxenos tree.\n' >&2
  exit 1
}

# Desktop Exec values use quoting of their own, not shell quoting. Newlines cannot form a
# single Exec value; double quotes protect spaces and the escapes are the desktop-file rules.
[[ "$gui" != *$'\n'* && "$gui" != *$'\r'* ]] || {
  printf 'install-desktop-entry: the tree name cannot contain a newline.\n' >&2
  exit 1
}
escaped=${gui//\\/\\\\}
escaped=${escaped//\"/\\\"}
escaped=${escaped//\$/\\$}
escaped=${escaped//\`/\\\`}
escaped=${escaped//%/%%}

mkdir -p -- "$(dirname -- "$entry")" "$(dirname -- "$icon")"
staged=$(mktemp "${entry}.XXXXXX")
trap 'rm -f -- "$staged"' EXIT
cat > "$staged" <<EOF
[Desktop Entry]
Type=Application
Name=Proxenos
Exec="$escaped"
Icon=proxenos
StartupWMClass=proxenos
Terminal=false
Categories=Utility;
EOF
chmod 0644 "$staged"
mv -f -- "$staged" "$entry"
install -m 0644 -- "$tree/share/icons/proxenos.svg" "$icon"
printf 'Installed the Proxenos desktop entry at %s.\n' "$entry"
