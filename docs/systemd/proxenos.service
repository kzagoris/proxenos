# Reference systemd user unit for the Proxenos Runtime (ADR 0015).
# Prefer Connection -> Runtime -> Start Runtime at boot in either frontend: it generates the
# installation-specific unit, preserves custom paths and checks the registration. Boot startup
# is off by default. The UI preserves the current Runtime when enabling or disabling it.
#
# Manual alternative, for administrators who will maintain their own unit:
#
#   mkdir -p ~/.config/systemd/user
#   cp docs/systemd/proxenos.service ~/.config/systemd/user/
#   # edit ExecStart below if you unpacked the distribution anywhere but docs/INSTALL.md's place
#   # on the portable archive, link jre/ in the tree to a Java 26 or newer (docs/INSTALL.md §3)
#   # if that is not the `java` on the user manager's PATH
#   systemctl --user daemon-reload
#   loginctl enable-linger
#   systemctl --user enable proxenos.service
#   # To start it now as well, first stop any existing detached Runtime, then:
#   systemctl --user start proxenos.service
#
# Disable future boot startup with `systemctl --user disable proxenos.service` (without --now).
# Stop the current Runtime separately. Leave account lingering enabled if other services use it.
# Lingering starts the user manager at boot, before login, and keeps it after logout; it also
# affects other enabled user services. Saved Access Levels and Connect/Disconnect state apply.
#
# Never add the tunnel ID or the runtime key to this file, as Environment= or otherwise. The
# Runtime reads them from ~/.config/proxenos/credentials (mode 0600) and ignores them in
# its own environment — a key in a unit file is a key in every backup of your home directory.

[Unit]
Description=Proxenos Runtime
Documentation=https://github.com/kzagoris/proxenos/blob/master/README.md

[Service]
Type=simple
# Where docs/INSTALL.md unpacks the distribution (`./gradlew distTar`).
ExecStart=%h/.local/opt/proxenos/bin/runtime
# The user manager does not read your shell profile, so a JAVA_HOME set there is not set here.
# A jre/ link in the tree needs neither; it wins over JAVA_HOME when present.
#Environment=JAVA_HOME=/path/to/your/java-26-or-newer
# The user manager's PATH is short and rarely includes ~/.local/bin. bin/install-tunnel-client
# puts tunnel-client in ~/.local/state/proxenos/tools/, which needs no PATH; name it here
# only if you keep it somewhere else (or set tunnel_client in config.toml).
#Environment=PROXENOS_TUNNEL_CLIENT=%h/.local/bin/tunnel-client

# Restart a Runtime that crashed, but not one that refused to start: a missing or
# world-readable credentials file, or a Runtime already running, exits 78, and no restart
# fixes any of those.
Restart=on-failure
RestartPreventExitStatus=78

# TERM reaches the Runtime alone, so its own shutdown ends the tunnel child and every running
# Operation in order, each with its 5 s grace. Whatever is still alive after the timeout is
# killed by systemd.
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=default.target
